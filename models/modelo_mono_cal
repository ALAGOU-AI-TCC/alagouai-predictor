# train_xgb_monocal.py
# -*- coding: utf-8 -*-
# Treino XGBoost (API nativa) com MONOTONIC CONSTRAINTS + Calibração Condicional (compat c/ versões antigas)
# - Sem StandardScaler
# - Remove 'chuva_media_h', 'declive_bin', 'slope_plano'
# - Monotonia NEGATIVA: declive_graus, solo_elevacao
# - Calibração isotônica separada p/ "sem chuva" e "com chuva"
# - Treino via xgboost.train(DMatrix) com early_stopping_rounds
# - Artefato final: ../models/modelo_xgb_mono_cal.pkl (wrapper com predict_proba)

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import joblib
from pathlib import Path

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.isotonic import IsotonicRegression
from sklearn.metrics import classification_report, roc_curve, auc, confusion_matrix

import xgboost as xgb  # vamos usar a API nativa

# =======================
# 0) Caminhos
# =======================
DATA_PATH   = '../data/processed/dados_processados.csv'
REPORTS_DIR = Path('../reports'); REPORTS_DIR.mkdir(parents=True, exist_ok=True)
MODELS_DIR  = Path('../models');  MODELS_DIR.mkdir(parents=True, exist_ok=True)
MODEL_OUT   = MODELS_DIR / 'modelo_xgb_mono_cal.pkl'

# =======================
# 1) Carrega dados
# =======================
df = pd.read_csv(DATA_PATH)

def numclip(s, low=None, high=None):
    s = pd.to_numeric(s, errors='coerce')
    if low is not None: s = s.clip(lower=low)
    if high is not None: s = s.clip(upper=high)
    return s

if 'tempo_chuva' in df.columns:
    df['tempo_chuva'] = numclip(df['tempo_chuva'], 0, 4).astype('int8')

for c in ['precipitacao_chuva','precipitacao_acumulada','solo_elevacao','ponto_orvalho',
          'temperatura','umidade','pressao','declive_graus']:
    if c in df.columns:
        df[c] = numclip(df[c], 0 if c in ['precipitacao_chuva','precipitacao_acumulada','solo_elevacao','declive_graus'] else None, None)

for c in ['chuva_media_h','declive_bin','slope_plano']:
    if c in df.columns:
        df.drop(columns=[c], inplace=True)

if 'intensidade_chuva' in df.columns:
    df['intensidade_chuva'] = df['intensidade_chuva'].astype(str).str.strip().str.lower()

y = df['historico_alagamento'].astype(int)

no_rain = (
    (df.get('precipitacao_chuva', 0).fillna(0) == 0) &
    (df.get('precipitacao_acumulada', 0).fillna(0) == 0) &
    (df.get('tempo_chuva', 0).fillna(0) == 0)
).astype(int)

# =======================
# 2) Features
# =======================
num_features = [c for c in [
    'temperatura','umidade','pressao',
    'precipitacao_chuva','ponto_orvalho',
    'precipitacao_acumulada','tempo_chuva',
    'declive_graus','solo_elevacao'
] if c in df.columns]

cat_features = [c for c in ['intensidade_chuva'] if c in df.columns]

X = df[num_features + cat_features].copy()

preprocessor = ColumnTransformer(
    transformers=[
        ('num', 'passthrough', num_features),
        ('cat', OneHotEncoder(handle_unknown='ignore'), cat_features)
    ],
    remainder='drop'
)

# Split para treino/calibração/teste
X_train_full, X_test, y_train_full, y_test, nr_train_full, nr_test = train_test_split(
    X, y, no_rain, test_size=0.20, stratify=y, random_state=42
)
X_tr, X_cal, y_tr, y_cal, nr_tr, nr_cal = train_test_split(
    X_train_full, y_train_full, nr_train_full, test_size=0.20, stratify=y_train_full, random_state=123
)

# Fit preprocessor e transforma
preprocessor.fit(X_tr)
Xtr = preprocessor.transform(X_tr)
Xcal = preprocessor.transform(X_cal)
Xte  = preprocessor.transform(X_test)

# =======================
# 3) Monotonic constraints
# =======================
feat_names = preprocessor.get_feature_names_out()
constraints = []
for f in feat_names:
    if f == 'num__declive_graus':
        constraints.append(-1)
    elif f == 'num__solo_elevacao':
        constraints.append(-1)
    else:
        constraints.append(0)

# Em versões antigas de xgboost.train, o formato string é mais robusto
mono_str = "(" + ",".join(str(int(c)) for c in constraints) + ")"

# =======================
# 4) Treino via xgboost.train (API nativa) com DMatrix
# =======================
dtr  = xgb.DMatrix(Xtr, label=y_tr)
dcal = xgb.DMatrix(Xcal, label=y_cal)
dte  = xgb.DMatrix(Xte,  label=y_test)

prev = float(y_tr.mean())

params = {
    'objective': 'binary:logistic',
    'eval_metric': 'logloss',
    'tree_method': 'hist',
    'eta': 0.05,
    'max_depth': 4,
    'subsample': 0.9,
    'colsample_bytree': 0.9,
    'lambda': 1.0,     # reg_lambda
    'gamma': 0.0,
    'seed': 42,
    'base_score': prev,
    'max_delta_step': 1,
    'monotone_constraints': mono_str,
}

num_boost_round = 600
watchlist = [(dcal, 'eval')]

booster = xgb.train(
    params=params,
    dtrain=dtr,
    num_boost_round=num_boost_round,
    evals=watchlist,
    early_stopping_rounds=50,
    verbose_eval=False
)

# =======================
# 5) Calibração condicional (isotônica)
# =======================
proba_cal_raw = booster.predict(dcal, iteration_range=(0, booster.best_iteration+1))

mask_norain = (nr_cal == 1).to_numpy()
mask_rain   = ~mask_norain

enough_norain = mask_norain.sum() >= 50 and y_cal[mask_norain].sum() >= 10
enough_rain   = mask_rain.sum()   >= 50 and y_cal[mask_rain].sum()   >= 10

iso_all = IsotonicRegression(out_of_bounds='clip')
iso_all.fit(proba_cal_raw, y_cal)

if enough_norain:
    iso_norain = IsotonicRegression(out_of_bounds='clip')
    iso_norain.fit(proba_cal_raw[mask_norain], y_cal[mask_norain])
else:
    iso_norain = None

if enough_rain:
    iso_rain = IsotonicRegression(out_of_bounds='clip')
    iso_rain.fit(proba_cal_raw[mask_rain], y_cal[mask_rain])
else:
    iso_rain = None

# =======================
# 6) Avaliação no teste (com calibração condicional)
# =======================
proba_test_raw = booster.predict(dte, iteration_range=(0, booster.best_iteration+1))

def apply_calibration(p, nr_flag):
    if iso_norain is None and iso_rain is None:
        return iso_all.transform(p)
    out = np.empty_like(p, dtype=float)
    if iso_norain is None:
        out[nr_flag==1] = iso_all.transform(p[nr_flag==1])
    else:
        out[nr_flag==1] = iso_norain.transform(p[nr_flag==1])
    if iso_rain is None:
        out[nr_flag==0] = iso_all.transform(p[nr_flag==0])
    else:
        out[nr_flag==0] = iso_rain.transform(p[nr_flag==0])
    return out

proba_test_cal = apply_calibration(proba_test_raw, nr_test.values)
y_pred = (proba_test_cal >= 0.50).astype(int)

rep = classification_report(y_test, y_pred, digits=3)
print("\nRelatório (Teste • prob calibrada condicional, thr=0.50):\n", rep)

cm = confusion_matrix(y_test, y_pred)
labels = ['Não Alagou', 'Alagou']
plt.figure(figsize=(6,4))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=labels, yticklabels=labels)
plt.title('Matriz de Confusão (Teste) • Mono+Cal condicional')
plt.tight_layout()
plt.savefig(REPORTS_DIR / 'xgbMONOCAL_confusion_test.png', dpi=300, bbox_inches='tight')
plt.close()

fpr, tpr, _ = roc_curve(y_test, proba_test_cal)
roc_auc = auc(fpr, tpr)
plt.figure(figsize=(6,6))
plt.plot(fpr, tpr, label=f'AUC (cal) = {roc_auc:.3f}')
plt.plot([0,1],[0,1],'k--')
plt.title('Curva ROC (Teste) • Mono+Cal condicional')
plt.legend(); plt.grid(True)
plt.savefig(REPORTS_DIR / 'xgbMONOCAL_roc_test.png', dpi=300, bbox_inches='tight')
plt.close()

with open(REPORTS_DIR / 'xgbMONOCAL_classification_report_test.txt','w',encoding='utf-8') as f:
    f.write(rep)

# =======================
# 7) Wrapper servível para a API
# =======================
class MonoCalibratedModel:
    """
    Aplica preprocessor -> Booster (xgboost.train) -> calibração condicional.
    Exponde predict_proba(X_df) no estilo sklearn (retorna n×2).
    """
    def __init__(self, preprocessor, booster, iso_all, iso_norain, iso_rain,
                 num_features, cat_features):
        self.preprocessor = preprocessor
        self.booster = booster
        self.iso_all = iso_all
        self.iso_norain = iso_norain
        self.iso_rain = iso_rain
        self.num_features = num_features
        self.cat_features = cat_features

    def _no_rain_mask(self, X_df: pd.DataFrame):
        pc = X_df.get('precipitacao_chuva', 0).fillna(0).astype(float)
        pa = X_df.get('precipitacao_acumulada', 0).fillna(0).astype(float)
        tc = X_df.get('tempo_chuva', 0).fillna(0).astype(float)
        return ((pc == 0.0) & (pa == 0.0) & (tc == 0.0)).to_numpy()

    def predict_proba(self, X_df: pd.DataFrame):
        Xt = self.preprocessor.transform(X_df[self.num_features + self.cat_features])
        dX = xgb.DMatrix(Xt)
        p_raw = self.booster.predict(dX, iteration_range=(0, self.booster.best_iteration+1))
        nr_mask = self._no_rain_mask(X_df)
        # calibração condicional
        if self.iso_norain is None and self.iso_rain is None:
            p_cal = self.iso_all.transform(p_raw)
        else:
            p_cal = np.empty_like(p_raw, dtype=float)
            if self.iso_norain is None:
                p_cal[nr_mask] = self.iso_all.transform(p_raw[nr_mask])
            else:
                p_cal[nr_mask] = self.iso_norain.transform(p_raw[nr_mask])
            if self.iso_rain is None:
                p_cal[~nr_mask] = self.iso_all.transform(p_raw[~nr_mask])
            else:
                p_cal[~nr_mask] = self.iso_rain.transform(p_raw[~nr_mask])
        p_cal = np.clip(p_cal, 0.0, 1.0)
        return np.vstack([1.0 - p_cal, p_cal]).T

    def predict(self, X_df: pd.DataFrame):
        return (self.predict_proba(X_df)[:,1] >= 0.50).astype(int)

serving_model = MonoCalibratedModel(
    preprocessor=preprocessor,
    booster=booster,
    iso_all=iso_all,
    iso_norain=iso_norain,
    iso_rain=iso_rain,
    num_features=num_features,
    cat_features=cat_features
)
joblib.dump(serving_model, MODEL_OUT)

